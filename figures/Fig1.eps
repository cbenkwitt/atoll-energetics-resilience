%%BeginProlog
/bdf    { bind def } bind def
/xdf    { exch def } bdf
/fltyp	{ /.fltyp exch def } bdf

/cp     { closepath } bdf
/np     { newpath } bdf
/F      { cp f } bdf
/S      { cp s } bdf

/fc     { f_scs f_csc } def
/sc     { s_scs s_csc } def

/rect  {
          3 index 3 index moveto
          3 index 1 index lineto
          2 copy lineto
          pop exch lineto
          pop
          cp
       } bdf

/1c_s  { 
%				/scs xdf 
					load /s_scs xdf
				/s_1 xdf
%       /s_scs  { scs setcolorspace } def
        /s_csc { s_1 setcolor } def
        /s     { 
				s_scs 
				s_csc stroke } def
       } bdf
       
/2c_s  { 
%				/scs xdf 
					load /s_scs xdf
				/s_22 xdf /s_12 xdf
%        /s_scs  { scs setcolorspace } def
        /s_csc { s_12 s_22 setcolor } def
        /s     { 
				s_scs 
        s_csc stroke } def
       } bdf

        
/3c_s  { 
%				/scs xdf 
					load /s_scs xdf
				/s_33 xdf /s_23 xdf /s_13 xdf
%       /s_scs  { scs setcolorspace } def
         /s_csc { s_13 s_23 s_33 setcolor } def
         /s     { 
        	s_scs 
         s_csc stroke } def
       } bdf
       
/4c_s	{
%				/scs xdf 
					load /s_scs xdf
				/s_44 xdf /s_34 xdf /s_24 xdf /s_14 xdf
%				/s_scs  { scs setcolorspace } def
        /s_csc { s_14 s_24 s_34 s_44 setcolor } def
        /s     { 
        	s_scs 
        	s_csc stroke } def
			} bdf

/sep_s  {
%					/s_scs xdf
						load /s_scs xdf
					/s_tint xdf
          /s  {
          	s_scs 
          	s_tint setcolor 
          	stroke } def
        } bdf

/1c_f	{ 
%				/fcs xdf 
					load /f_scs xdf
				/f_1 xdf 
%				/f_scs  { fcs setcolorspace } def
				/f_csc  { f_1 setcolor } def
				.fltyp
				{ /f    { 
					f_scs 
					f_csc eofill } def }
				{ /f    { 
         	f_scs 
         	f_csc fill } def }
				ifelse
			} bdf
       
/2c_f	{
%				/fcs xdf 
					load /f_scs xdf
				/f_22 xdf /f_12 xdf 
%				/f_scs  { fcs setcolorspace } def
				/f_csc  { f_12 f_22 setcolor } def
         .fltyp
				{ /f    { 
					f_scs 
					f_csc eofill } def }
				{ /f    { 
					f_scs 
					f_csc fill } def }
				ifelse
			} bdf
      
    
/3c_f	{
%				/fcs xdf 
					load /f_scs xdf
				/f_33 xdf /f_23 xdf /f_13 xdf
%				/f_scs  { fcs setcolorspace } def
				/f_csc  { f_13 f_23 f_33 setcolor } def
				.fltyp
				{ /f    { 
					f_scs 
					f_csc eofill } def }
				{ /f    { 
					f_scs 
					f_csc fill } def }
				ifelse
			} bdf
       
/4c_f	{
%				/fcs xdf 
					load /f_scs xdf
				/f_44 xdf /f_34 xdf /f_24 xdf /f_14 xdf
%				/f_scs  { fcs setcolorspace } def
				/f_csc  { f_14 f_24 f_34 f_44 setcolor } def
				.fltyp
				{ /f    { 
					f_scs 
					f_csc eofill } def }
				{ /f    { 
					f_scs 
					f_csc fill } def }
				ifelse
			} bdf

       
/patt_s {
					/s_pcs xdf 
					/sm_66 xdf /sm_56 xdf /sm_46 xdf /sm_36 xdf /sm_26 xdf /sm_16 xdf
          /s { s_pcs /Pattern findresource [sm_16 sm_26 sm_36 sm_46 sm_56 sm_66] makepattern setpattern stroke } def
        } bdf
         
/patt_f {
					/f_pcs xdf 
					/fm_66 xdf /fm_56 xdf /fm_46 xdf /fm_36 xdf /fm_26 xdf /fm_16 xdf
          .fltyp
          { /f { f_pcs /Pattern findresource [fm_16 fm_26 fm_36 fm_46 fm_56 fm_66] makepattern setpattern eofill } def }
          { /f { f_pcs /Pattern findresource [fm_16 fm_26 fm_36 fm_46 fm_56 fm_66] makepattern setpattern fill } def }
          ifelse  
        } bdf
         
/sep_f  {
%					/f_scs xdf
						load /f_scs xdf
					/f_tint xdf
          .fltyp
          { /f { f_scs f_tint setcolor eofill } def }
          { /f { f_scs f_tint setcolor fill } def }
          ifelse  
        } bdf
                

/fs     { gsave f grestore s } bdf
/FS     { cp fs } bdf

/CreateDataArray
{
/temp exch def
  [
    {
      temp 16384 string readstring
      not { exit } if
    } loop
    dup length 0 eq { pop } if
  ]
} bind def
%%EndProlog

/GetCS { [ /DeviceRGB ] } bind def
/SetCS { GetCS setcolorspace } bind def

%%BeginSetup
% NotDefFont: all glyphs of this font are /.notdef, and produce dummy output
8 dict begin
  /FontType 3 def % Required elements of font
  /FontMatrix [.001 0 0 .001 0 0] def
  /FontBBox [0 0 750 750] def

  /Encoding 256 array def % Trivial encoding vector
		0 1 255 {Encoding exch /.notdef put} for

	/CharProcs 1 dict def % Subsidiary dictionary for
	CharProcs begin % individual glyph descriptions
  	/.notdef 
  	{
  		0 0 moveto
  		750 0 lineto
  		750 750 lineto
  		0 750 lineto
  		closepath
  		10 10 lineto
  		750 10 lineto
  		750 740 lineto
  		10 740 lineto
  		closepath
  		fill
  	} def
	end % End of CharProcs

	/BuildGlyph % Stack contains: font charname
	{
		1000 0 % Width
		0 0 750 750 % Bounding box
		setcachedevice
		exch /CharProcs get exch % Get CharProcs dictionary
		2 copy known not % See if charname is known
		{ pop /.notdef } if
		get exec % Execute BuildGlyph procedure
	} bind def

  /BuildChar % LanguageLevel 1 compatibility
  {
  	1 index /Encoding get exch get
	  1 index /BuildGlyph get exec
  } bind def

	currentdict
end % End of font dictionary
/NotDefFont exch definefont pop
%%EndSetup

%%Page: 0 0
%%BeginPageSetup
0.12 0.12 scale
0 8160 translate 1 -1 scale
/pgsetup save def
newpath
512 dict begin
gsave
false fltyp
%%EndPageSetup

gsave
/IMGSAVE_0 save def
[4096 0 0 -1168 0 1168] concat
SetCS
<<
/ImageType 1
/Width 4096
/Height 1168
/ImageMatrix [4096 0 0 -1168 0 1168]
/BitsPerComponent 8
/Decode [0 1 0 1 0 1]
/Interpolate true
/DataSource currentfile
/ASCII85Decode filter
/FlateDecode filter
>>
